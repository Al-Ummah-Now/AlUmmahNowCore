{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Al-Ummah-Now/AlUmmahNowCore/schemas/edl/v1.json",
  "title": "Al Ummah Now Studio project (EDL) v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "metadata",
    "settings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "markers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/marker"
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "createdAtMs",
        "updatedAtMs"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "createdAtMs": {
          "type": "integer"
        },
        "updatedAtMs": {
          "type": "integer"
        }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps",
        "sampleRate",
        "channels"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "path",
        "durationMs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "video": {
          "type": "object",
          "required": [
            "codec",
            "width",
            "height",
            "fps"
          ],
          "additionalProperties": false,
          "properties": {
            "codec": {
              "type": "string"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "audio": {
          "type": "object",
          "required": [
            "codec",
            "sampleRate",
            "channels"
          ],
          "additionalProperties": false,
          "properties": {
            "codec": {
              "type": "string"
            },
            "sampleRate": {
              "type": "integer",
              "minimum": 1
            },
            "channels": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "keyframesMs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "track": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "video",
            "audio",
            "title",
            "caption"
          ]
        },
        "name": {
          "type": "string"
        },
        "muted": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "burnIn": {
          "type": "boolean"
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clip"
          }
        },
        "titles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/title"
          }
        },
        "captions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caption"
          }
        }
      }
    },
    "clip": {
      "type": "object",
      "required": [
        "id",
        "sourceId",
        "inMs",
        "outMs",
        "timelineStartMs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "inMs": {
          "type": "integer",
          "minimum": 0
        },
        "outMs": {
          "type": "integer",
          "minimum": 0
        },
        "timelineStartMs": {
          "type": "integer",
          "minimum": 0
        },
        "speed": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "transition": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "fromClipId",
        "toClipId",
        "durationMs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "crossfade",
            "dip_to_black"
          ]
        },
        "fromClipId": {
          "type": "string"
        },
        "toClipId": {
          "type": "string"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "title": {
      "type": "object",
      "required": [
        "id",
        "startMs",
        "durationMs",
        "text",
        "style"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "style": {
          "type": "object",
          "required": [
            "fontFamily",
            "sizePt",
            "color",
            "position"
          ],
          "additionalProperties": false,
          "properties": {
            "fontFamily": {
              "type": "string"
            },
            "sizePt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "position": {
              "enum": [
                "top",
                "center",
                "lowerThird"
              ]
            }
          }
        }
      }
    },
    "caption": {
      "type": "object",
      "required": [
        "id",
        "startMs",
        "endMs",
        "text",
        "locale"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "marker": {
      "type": "object",
      "required": [
        "id",
        "timeMs",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timeMs": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "chapter": {
          "type": "boolean"
        }
      }
    }
  }
}
