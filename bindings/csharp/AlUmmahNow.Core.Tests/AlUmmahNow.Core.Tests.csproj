<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AunProfile Condition="'$(AunProfile)' == ''">debug</AunProfile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AlUmmahNow.Core/AlUmmahNow.Core.csproj" />
  </ItemGroup>
  <!-- The host build of aun_core from target/<profile>/ -->
  <ItemGroup>
    <None Include="../../../target/$(AunProfile)/libaun_core.dylib" Condition="Exists('../../../target/$(AunProfile)/libaun_core.dylib')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../target/$(AunProfile)/libaun_core.so" Condition="Exists('../../../target/$(AunProfile)/libaun_core.so')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../target/$(AunProfile)/aun_core.dll" Condition="Exists('../../../target/$(AunProfile)/aun_core.dll')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
