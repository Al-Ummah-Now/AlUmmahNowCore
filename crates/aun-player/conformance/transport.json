          ]
        },
        {
          "at_ms": 5002,
          "input": {
            "type": "skip_forward"
          },
          "expect": [
            {
              "type": "seek_to",
              "position_ms": 10000
            },
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 10000,
              "duration_ms": 15000,
              "completed": false
            }
          ]
        },
        {
          "at_ms": 5003,
          "input": {
            "type": "skip_forward"
          },
          "expect": [
            {
              "type": "seek_to",
              "position_ms": 15000
            },
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 15000,
              "duration_ms": 15000,
              "completed": true
            }
          ]
        }
      ]
    },
    {
      "name": "playback_rate_clamped_and_kept",
      "description": "Rate is clamped to 0.5–2× and re-applied after every load.",
      "steps": [
        {
          "at_ms": 0,
          "input": {
            "type": "load_queue",
            "items": [
              {
                "id": "a",
                "duration_ms": 600000
              },
              {
                "id": "b",
                "duration_ms": 600000
              }
            ],
            "start_index": 0,
            "play_when_ready": true
          },
          "expect": [
            {
              "type": "load",
              "item_id": "a",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ]
        },
        {
          "at_ms": 1,
          "input": {
            "type": "set_rate",
            "rate": 1.5
          },
          "expect": [
            {
              "type": "set_rate",
              "rate": 1.5
            }
          ],
          "expect_state": {
            "rate": 1.5
          }
        },
        {
          "at_ms": 2,
          "input": {
            "type": "set_rate",
            "rate": 4.0
          },
          "expect": [
            {
              "type": "set_rate",
              "rate": 2.0
            }
          ]
        },
        {
          "at_ms": 3,
          "input": {
            "type": "set_rate",
            "rate": 2.0
          },
          "expect": []
        },
        {
          "at_ms": 4,
          "input": {
            "type": "set_rate",
            "rate": 0.25
          },
          "expect": [
            {
              "type": "set_rate",
              "rate": 0.5
            }
          ]
        },
        {
          "at_ms": 5,
          "input": {
            "type": "next"
          },
          "expect": [
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 0,
              "duration_ms": 600000,
              "completed": false
            },
            {
              "type": "load",
              "item_id": "b",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            },
            {
              "type": "set_rate",
              "rate": 0.5
            }
          ]
        }
      ]
    },
