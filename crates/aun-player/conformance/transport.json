    {
      "name": "system_interruption",
      "description": "A pause by the system saves; a resume by the system emits nothing.",
      "steps": [
        {
          "at_ms": 0,
          "input": {
            "type": "load_queue",
            "items": [
              {
                "id": "a",
                "duration_ms": 600000
              }
            ],
            "start_index": 0,
            "play_when_ready": true
          },
          "expect": [
            {
              "type": "load",
              "item_id": "a",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ]
        },
        {
          "at_ms": 4000,
          "input": {
            "type": "tick",
            "position_ms": 4000
          },
          "expect": []
        },
        {
          "at_ms": 4001,
          "input": {
            "type": "playback_paused"
          },
          "expect": [
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 4000,
              "duration_ms": 600000,
              "completed": false
            }
          ],
          "expect_state": {
            "state": "paused"
          }
        },
        {
          "at_ms": 9000,
          "input": {
            "type": "playback_started"
          },
          "expect": [],
          "expect_state": {
            "state": "playing"
          }
        }
      ]
