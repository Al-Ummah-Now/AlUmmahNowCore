    {
      "name": "stop_then_play_reloads",
      "description": "Stop saves and releases; Play reloads at the same position.",
      "steps": [
        {
          "at_ms": 0,
          "input": {
            "type": "load_queue",
            "items": [
              {
                "id": "a",
                "duration_ms": 600000
              }
            ],
            "start_index": 0,
            "play_when_ready": true
          },
          "expect": [
            {
              "type": "load",
              "item_id": "a",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ]
        },
        {
          "at_ms": 42000,
          "input": {
            "type": "tick",
            "position_ms": 42000
          },
          "expect": [
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 42000,
              "duration_ms": 600000,
              "completed": false
            }
          ]
        },
        {
          "at_ms": 42001,
          "input": {
            "type": "stop"
          },
          "expect": [
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 42000,
              "duration_ms": 600000,
              "completed": false
            },
            {
              "type": "stop"
            }
          ],
          "expect_state": {
            "state": "stopped"
          }
        },
        {
          "at_ms": 42002,
          "input": {
            "type": "stop"
          },
          "expect": []
        },
        {
          "at_ms": 50000,
          "input": {
            "type": "play"
          },
          "expect": [
            {
              "type": "load",
              "item_id": "a",
              "start_position_ms": 42000,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ],
          "expect_state": {
            "state": "playing"
          }
        }
      ]
    },
    {
      "name": "failure_then_retry",
      "description": "A failure saves; Play retries by reloading at the position.",
