                "max_height": 1080
              }
            }
          ]
        },
        {
          "at_ms": 5000,
          "input": {
            "type": "tick",
            "position_ms": 5000
          },
          "expect": []
        },
        {
          "at_ms": 5001,
          "input": {
            "type": "skip_backward"
          },
          "expect": [
            {
              "type": "seek_to",
              "position_ms": 0
