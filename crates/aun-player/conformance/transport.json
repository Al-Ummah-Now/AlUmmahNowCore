            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ]
        }
      ]
    },
    {
      "name": "seek_clamped_and_ends_pause",
      "description": "Seeks clamp to the duration; seeking after the end leaves the player paused.",
      "steps": [
        {
          "at_ms": 0,
          "input": {
            "type": "load_queue",
            "items": [
              {
                "id": "a",
                "duration_ms": 60000
              }
            ],
            "start_index": 0,
            "play_when_ready": true
          },
          "expect": [
            {
              "type": "load",
              "item_id": "a",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ]
        },
        {
          "at_ms": 1,
          "input": {
            "type": "seek_to",
            "position_ms": 999999
          },
          "expect": [
            {
              "type": "seek_to",
              "position_ms": 60000
            },
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 60000,
              "duration_ms": 60000,
              "completed": true
            }
          ]
        },
        {
          "at_ms": 60000,
          "input": {
            "type": "ended"
          },
          "expect": [
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 60000,
              "duration_ms": 60000,
              "completed": true
            },
            {
              "type": "queue_ended"
            }
          ]
        },
        {
          "at_ms": 60001,
          "input": {
            "type": "seek_to",
            "position_ms": 1000
          },
          "expect": [
            {
              "type": "seek_to",
              "position_ms": 1000
            },
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 1000,
              "duration_ms": 60000,
              "completed": false
            }
          ],
          "expect_state": {
            "state": "paused"
          }
        }
      ]
    },
