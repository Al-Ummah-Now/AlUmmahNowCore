{
  "scenarios": [
    {
      "name": "pause_and_play",
      "description": "Pause saves the position; Play resumes.",
      "steps": [
        {
          "at_ms": 0,
          "input": {
            "type": "load_queue",
            "items": [
              {
                "id": "a",
                "duration_ms": 600000
              }
            ],
            "start_index": 0,
            "play_when_ready": true
          },
          "expect": [
            {
              "type": "load",
              "item_id": "a",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ]
        },
        {
          "at_ms": 1000,
          "input": {
            "type": "tick",
            "position_ms": 1000
          },
          "expect": []
        },
        {
          "at_ms": 1001,
          "input": {
            "type": "pause"
          },
          "expect": [
            {
              "type": "pause"
            },
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 1000,
              "duration_ms": 600000,
              "completed": false
            }
          ],
          "expect_state": {
            "state": "paused"
          }
        },
        {
          "at_ms": 1002,
          "input": {
            "type": "pause"
          },
          "expect": []
        },
        {
          "at_ms": 2000,
          "input": {
            "type": "play"
          },
          "expect": [
            {
              "type": "play"
            }
          ],
          "expect_state": {
            "state": "playing"
          }
        }
      ]
    },
    {
      "name": "skip_ten_seconds",
      "description": "Skip moves 10 s and clamps to [0, duration].",
      "steps": [
        {
          "at_ms": 0,
          "input": {
            "type": "load_queue",
            "items": [
              {
                "id": "a",
                "duration_ms": 15000
