    {
      "name": "previous_restarts_after_3s",
      "description": "Previous restarts the item when more than 3 s in, otherwise goes to the previous item; at the first item it restarts.",
      "steps": [
        {
          "at_ms": 0,
          "input": {
            "type": "load_queue",
            "items": [
              {
                "id": "a",
                "duration_ms": 600000
              },
              {
                "id": "b",
                "duration_ms": 600000
              }
            ],
            "start_index": 1,
            "play_when_ready": true
          },
          "expect": [
            {
              "type": "load",
              "item_id": "b",
              "start_position_ms": 0,
              "play_when_ready": true
