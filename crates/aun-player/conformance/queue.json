{
  "scenarios": [
    {
      "name": "autoplay_advances_then_queue_ends",
      "description": "Autoplay is on by default: Ended loads the next item; the last Ended reports queue_ended.",
      "steps": [
        {
          "at_ms": 0,
          "input": {
            "type": "load_queue",
            "items": [
              {
                "id": "a",
                "duration_ms": 60000
              },
              {
                "id": "b",
                "duration_ms": 60000
              }
            ],
            "start_index": 0,
            "play_when_ready": true
          },
          "expect": [
            {
              "type": "load",
              "item_id": "a",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ],
          "expect_state": {
            "state": "playing",
            "current_item_id": "a"
          }
        },
        {
          "at_ms": 60000,
          "input": {
            "type": "ended"
          },
          "expect": [
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 60000,
              "duration_ms": 60000,
              "completed": true
            },
            {
              "type": "load",
              "item_id": "b",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ],
          "expect_state": {
            "current_item_id": "b"
          }
        },
        {
          "at_ms": 120000,
          "input": {
            "type": "ended"
          },
          "expect": [
            {
              "type": "save_position",
              "item_id": "b",
              "position_ms": 60000,
              "duration_ms": 60000,
              "completed": true
            },
            {
              "type": "queue_ended"
            }
          ],
          "expect_state": {
            "state": "ended"
          }
        },
        {
          "at_ms": 120001,
          "input": {
            "type": "ended"
          },
          "expect": []
        }
      ]
    },
    {
      "name": "autoplay_off_stays_on_item",
      "description": "With autoplay off, Ended stays on the item; Next still works; Play replays.",
      "steps": [
        {
          "at_ms": 0,
          "input": {
            "type": "load_queue",
            "items": [
              {
                "id": "a",
                "duration_ms": 60000
              },
              {
                "id": "b",
                "duration_ms": 60000
              }
            ],
            "start_index": 0,
            "play_when_ready": true
          },
          "expect": [
            {
              "type": "load",
              "item_id": "a",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ]
        },
        {
          "at_ms": 1,
          "input": {
            "type": "set_autoplay",
            "enabled": false
          },
          "expect": []
        },
        {
          "at_ms": 60000,
          "input": {
            "type": "ended"
          },
          "expect": [
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 60000,
              "duration_ms": 60000,
              "completed": true
            }
          ],
          "expect_state": {
            "state": "ended",
            "current_item_id": "a"
          }
        },
        {
          "at_ms": 60100,
          "input": {
            "type": "play"
          },
          "expect": [
            {
              "type": "seek_to",
              "position_ms": 0
            },
            {
              "type": "play"
            }
          ],
          "expect_state": {
            "state": "playing",
            "position_ms": 0
          }
        },
        {
          "at_ms": 60200,
          "input": {
            "type": "next"
          },
          "expect": [
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 0,
              "duration_ms": 60000,
              "completed": false
            },
            {
              "type": "load",
              "item_id": "b",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ],
          "expect_state": {
            "current_item_id": "b"
          }
        }
      ]
    },
