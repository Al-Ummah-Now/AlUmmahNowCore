{
  "scenarios": [
    {
      "name": "ab_loop_repeats_forever",
      "description": "Crossing B jumps back to A until the loop is cleared.",
      "steps": [
        {
          "at_ms": 0,
          "input": {
            "type": "load_queue",
            "items": [
              {
                "id": "a",
                "duration_ms": 60000
              }
            ],
            "start_index": 0,
            "play_when_ready": true
          },
          "expect": [
            {
              "type": "load",
              "item_id": "a",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ]
        },
        {
          "at_ms": 1000,
          "input": {
            "type": "tick",
            "position_ms": 15000
          },
          "expect": []
        },
        {
          "at_ms": 1001,
          "input": {
            "type": "set_ab_loop",
            "start_ms": 10000,
            "end_ms": 20000
          },
          "expect": [],
          "expect_state": {
            "has_ab_loop": true
          }
        },
        {
          "at_ms": 6000,
          "input": {
            "type": "tick",
            "position_ms": 20500
          },
          "expect": [
            {
              "type": "seek_to",
              "position_ms": 10000
            }
          ],
          "expect_state": {
            "position_ms": 10000
          }
        },
        {
          "at_ms": 16000,
          "input": {
            "type": "tick",
            "position_ms": 20200
          },
          "expect": [
            {
              "type": "seek_to",
              "position_ms": 10000
            }
          ]
        },
        {
          "at_ms": 16001,
          "input": {
            "type": "clear_ab_loop"
          },
          "expect": [],
          "expect_state": {
            "has_ab_loop": false
          }
        },
        {
          "at_ms": 27000,
          "input": {
            "type": "tick",
            "position_ms": 21000
          },
          "expect": [
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 21000,
              "duration_ms": 60000,
              "completed": false
            }
          ]
        }
      ]
    },
    {
      "name": "ab_loop_repeat_three_times",
      "description": "With repeat-count 3 the segment plays three times, then playback continues.",
      "steps": [
        {
          "at_ms": 0,
          "input": {
            "type": "load_queue",
            "items": [
              {
                "id": "a",
                "duration_ms": 60000
              }
            ],
            "start_index": 0,
            "play_when_ready": true
          },
          "expect": [
            {
              "type": "load",
              "item_id": "a",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ]
        },
        {
          "at_ms": 1000,
          "input": {
            "type": "tick",
            "position_ms": 25000
          },
          "expect": []
        },
        {
          "at_ms": 1001,
          "input": {
            "type": "set_repeat_count",
            "times": 3
          },
          "expect": []
        },
        {
          "at_ms": 1002,
          "input": {
            "type": "set_ab_loop",
            "start_ms": 10000,
            "end_ms": 20000
          },
          "expect": [
            {
              "type": "seek_to",
              "position_ms": 10000
            },
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 10000,
              "duration_ms": 60000,
              "completed": false
            }
          ]
        },
        {
          "at_ms": 1003,
          "input": {
            "type": "tick",
            "position_ms": 20100
          },
          "expect": [
            {
              "type": "seek_to",
              "position_ms": 10000
            }
          ]
        },
        {
          "at_ms": 1004,
          "input": {
            "type": "tick",
            "position_ms": 20100
          },
          "expect": [
            {
              "type": "seek_to",
              "position_ms": 10000
            }
          ]
        },
        {
          "at_ms": 1005,
          "input": {
            "type": "tick",
            "position_ms": 20100
          },
          "expect": [
            {
              "type": "repeat_finished"
            }
          ],
          "expect_state": {
            "has_ab_loop": false
          }
        },
        {
          "at_ms": 1006,
          "input": {
            "type": "tick",
            "position_ms": 21000
          },
          "expect": []
        }
      ]
    },
    {
      "name": "ab_loop_reaching_the_end",
      "description": "A loop whose B is the end loops on Ended and resumes playback.",
      "steps": [
        {
          "at_ms": 0,
          "input": {
            "type": "load_queue",
            "items": [
              {
                "id": "a",
                "duration_ms": 60000
              }
            ],
            "start_index": 0,
            "play_when_ready": true
          },
          "expect": [
            {
              "type": "load",
              "item_id": "a",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ]
        },
        {
          "at_ms": 1,
          "input": {
            "type": "set_ab_loop",
            "start_ms": 50000,
            "end_ms": 90000
          },
          "expect": [
            {
              "type": "seek_to",
              "position_ms": 50000
            },
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 50000,
              "duration_ms": 60000,
              "completed": false
            }
          ]
        },
        {
          "at_ms": 10000,
          "input": {
            "type": "ended"
          },
          "expect": [
            {
              "type": "seek_to",
              "position_ms": 50000
            },
            {
              "type": "play"
            }
          ],
          "expect_state": {
            "state": "playing",
            "has_ab_loop": true
          }
        }
      ]
    },
    {
      "name": "repeat_item_twice",
      "description": "Repeat-count without a loop replays the whole item.",
      "steps": [
        {
          "at_ms": 0,
          "input": {
            "type": "load_queue",
            "items": [
              {
                "id": "a",
                "duration_ms": 60000
              }
            ],
            "start_index": 0,
            "play_when_ready": true
          },
          "expect": [
            {
              "type": "load",
              "item_id": "a",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ]
        },
        {
          "at_ms": 1,
          "input": {
            "type": "set_repeat_count",
            "times": 2
          },
          "expect": []
        },
        {
          "at_ms": 60000,
          "input": {
            "type": "ended"
          },
          "expect": [
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 60000,
              "duration_ms": 60000,
              "completed": true
            },
            {
              "type": "seek_to",
              "position_ms": 0
            },
            {
              "type": "play"
            }
          ]
        },
        {
          "at_ms": 120000,
          "input": {
            "type": "ended"
          },
          "expect": [
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 60000,
              "duration_ms": 60000,
              "completed": true
            },
            {
              "type": "repeat_finished"
            },
            {
              "type": "queue_ended"
            }
          ]
        }
      ]
    },
    {
      "name": "study_tools_reset_on_new_item",
      "description": "Loading another item clears the A–B loop and repeat count.",
      "steps": [
        {
          "at_ms": 0,
          "input": {
            "type": "load_queue",
            "items": [
              {
                "id": "a",
                "duration_ms": 60000
              },
              {
                "id": "b",
                "duration_ms": 60000
              }
            ],
            "start_index": 0,
            "play_when_ready": true
          },
          "expect": [
            {
              "type": "load",
              "item_id": "a",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ]
        },
        {
          "at_ms": 1,
          "input": {
            "type": "set_ab_loop",
            "start_ms": 0,
            "end_ms": 5000
          },
          "expect": []
        },
        {
          "at_ms": 2,
          "input": {
            "type": "next"
          },
          "expect": [
            {
              "type": "save_position",
              "item_id": "a",
              "position_ms": 0,
              "duration_ms": 60000,
              "completed": false
            },
            {
              "type": "load",
              "item_id": "b",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ],
          "expect_state": {
            "has_ab_loop": false
          }
        },
        {
          "at_ms": 9000,
          "input": {
            "type": "tick",
            "position_ms": 6000
          },
          "expect": []
        }
      ]
    },
    {
      "name": "invalid_loop_ignored",
      "description": "A loop with A >= B, or on a live item, is ignored.",
      "steps": [
        {
          "at_ms": 0,
          "input": {
            "type": "load_queue",
            "items": [
              {
                "id": "a",
                "duration_ms": 60000
              }
            ],
            "start_index": 0,
            "play_when_ready": true
          },
          "expect": [
            {
              "type": "load",
              "item_id": "a",
              "start_position_ms": 0,
              "play_when_ready": true
            },
            {
              "type": "set_quality_cap",
              "cap": {
                "max_height": 1080
              }
            }
          ]
        },
        {
          "at_ms": 1,
          "input": {
            "type": "set_ab_loop",
            "start_ms": 5000,
            "end_ms": 5000
          },
          "expect": [],
          "expect_state": {
            "has_ab_loop": false
          }
        },
        {
          "at_ms": 2,
          "input": {
            "type": "set_ab_loop",
            "start_ms": 70000,
            "end_ms": 80000
          },
          "expect": [],
          "expect_state": {
            "has_ab_loop": false
          }
        }
      ]
    }
  ]
}
